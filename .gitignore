# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
web/node_modules/
blockchain/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
web/coverage/

# next.js
web/.next/
web/out/
./node_modules
.next
.playwright-mcp
# production
web/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*



# vercel
.vercel

# typescript
*.tsbuildinfo
web/next-env.d.ts

web/src/generated/prisma

# Legacy local KYC document uploads (now stored in the database)
web/public/uploads/

# SQLite database files
*.db
*.db-journal
*.db-wal
*.db-shm

# Hardhat — artifacts and local dependencies
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/

# Developer-panel state (keeper pause flag, restore-point id) — local only
web/.dev-mode.json

# Environment files — contain live secrets (DB creds, owner private key, API
# keys). Never commit these; copy from .env.example instead.
.env
.env.*
!.env.example
!web/.env.example
