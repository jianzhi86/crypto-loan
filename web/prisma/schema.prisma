generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Single direct connection. On Railway, set this to the Railway Postgres
  // service URL (reference ${{ Postgres.DATABASE_URL }}). No pooler/directUrl
  // needed since the DB is reachable directly within the Railway network.
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  password      String?
  walletAddress String?       @unique
  isAdmin       Boolean       @default(false)
  /// ACTIVE = normal. RESTRICTED = may sign in and read, but every write is refused.
  /// SUSPENDED = refused at sign-in entirely; getSessionUser() treats the session
  /// as absent, and suspending bumps sessionEpoch to kill any live token.
  /// Off-chain only: any of these users can still call the contract directly from
  /// their own wallet — see lib/authz.ts for the full caveat.
  status        String        @default("ACTIVE")
  statusReason  String?
  statusChangedAt DateTime?
  /// Bumped to invalidate every JWT already issued to this user (password reset).
  sessionEpoch  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  kyc           KycSubmission?
}

/// Admin-controlled toggle for a single feature. Only keys declared in
/// lib/features.ts are meaningful; rows here are overrides on top of the
/// registry defaults, so an empty table means "everything on".
model FeatureFlag {
  key       String   @id
  /// 'ON' | 'MAINTENANCE' (visible but blocked) | 'HIDDEN' (invisible)
  state     String   @default("ON")
  message   String   @default("")
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

/// Append-only record of every admin mutation. Never edited or deleted by the app.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String?
  action     String
  targetType String
  targetId   String
  /// JSON blob of the change ({ before, after }); stored as text to stay
  /// portable across the raw-SQL paths this app uses.
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model LoanTransaction {
  id          String   @id @default(cuid())
  wallet      String
  type        String
  amount      String
  txHash      String   @unique
  blockNumber Int
  createdAt   DateTime @default(now())

  @@index([wallet])
}

/// One row per on-chain borrow — the tranche ledger for itemized repayment.
/// The contract aggregates all of a wallet's borrows into a single position;
/// these rows preserve each borrow's own timestamp and the APR captured at
/// that moment, so the Repay tab can list every borrow separately and settle
/// them one by one (principal + interest grown at the locked rate since
/// borrowedAt). The chain stays authoritative for totals; this is the
/// itemization layer on top.
model BorrowPosition {
  id           String    @id @default(cuid())
  wallet       String
  /// MYR units (1e6), stringified — bigint-safe. Shrinks as settle() applies
  /// payments; never the original borrowed amount after the first payment.
  principal    String
  /// `principal`'s value at creation, frozen — settle() never touches this.
  /// Needed to tell how much of the installment PLAN has actually been paid
  /// off (installmentsPaid = (originalPrincipal - principal) / (originalPrincipal
  /// / termMonths)), independent of how much elapsed calendar time. Without
  /// it, paying an installment early has no way to advance "Month X of N" —
  /// only elapsed time could, so an early payoff still divided by the full
  /// term instead of by what's actually left.
  originalPrincipal String @default("0")
  /// Borrow APR in basis points, read from currentAprBps() at borrow time.
  aprBps       Int
  /// Base rate (bps, from baseRateBps()) at the same moment — display only,
  /// for the "base + premium = rate" breakdown on this row. Never used for
  /// any money math; aprBps (the effective rate) is what interest is priced
  /// off everywhere else. Defaults to 0 for rows recorded before this field
  /// existed, meaning "unknown" — the UI falls back to aprBps-only in that case.
  baseAprBps   Int       @default(0)
  /// Installment plan length in months (1/3/6/12 — the same options the
  /// Borrow tab's own Loan Term selector offers), captured at borrow time.
  /// Drives the Repay tab's "this month's bill": remaining balance divided
  /// by however many months of the plan are left. Defaults to 1 for rows
  /// created before this field existed, matching their old single-cycle
  /// "pay it this month" behavior.
  termMonths   Int       @default(1)
  txHash       String    @unique
  borrowedAt   DateTime  @default(now())
  status       String    @default("OPEN") // OPEN | REPAID
  repaidAt     DateTime?
  repayTxHash  String?
  /// MYR units of ledger interest attributed to this tranche at settlement.
  interestPaid String?

  @@index([wallet, status])
}

model KycSubmission {
  id          Int      @id @default(autoincrement())
  /// KYC belongs to the *account*: one submission per user, and it survives
  /// wallet unlinking. Keying by wallet was the old model, and it let the next
  /// account to claim a freed wallet inherit a stranger's verification.
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  /// The wallet this verification is anchored to on-chain (contract setKYC).
  /// Null until the account links a wallet — KYC submission and approval no
  /// longer require one. Ownership is decided by userId, never by wallet.
  wallet      String?
  fullName    String
  docType     String   @default("ic")
  icNumber    String
  dob         String
  gender      String
  nationality String
  phone       String
  email       String
  addr1       String
  addr2       String   @default("")
  postcode    String
  city        String
  state       String
  employment  String
  income      String
  purpose     String
  fundSource  String
  // Document images stored in-DB as data URIs (data:image/jpeg;base64,...), so
  // they are shared across all users via the same Supabase database. Served by
  // GET /api/kyc/documents.
  icFrontData String?
  icBackData  String?
  selfieData  String?
  status      String   @default("pending")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([wallet])
}
