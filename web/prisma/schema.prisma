generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Single direct connection. On Railway, set this to the Railway Postgres
  // service URL (reference ${{ Postgres.DATABASE_URL }}). No pooler/directUrl
  // needed since the DB is reachable directly within the Railway network.
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  password      String?
  walletAddress String?       @unique
  isAdmin       Boolean       @default(false)
  /// ACTIVE = normal. RESTRICTED = may sign in and read, but every write is refused.
  /// Off-chain only: a RESTRICTED user can still call the contract directly from
  /// their own wallet — see lib/authz.ts for the full caveat.
  status        String        @default("ACTIVE")
  statusReason  String?
  statusChangedAt DateTime?
  /// Bumped to invalidate every JWT already issued to this user (password reset).
  sessionEpoch  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  bankAccount   BankAccount?
  transfers     BankTransfer[]
  kyc           KycSubmission?
}

/// Admin-controlled toggle for a single feature. Only keys declared in
/// lib/features.ts are meaningful; rows here are overrides on top of the
/// registry defaults, so an empty table means "everything on".
model FeatureFlag {
  key       String   @id
  /// 'ON' | 'MAINTENANCE' (visible but blocked) | 'HIDDEN' (invisible)
  state     String   @default("ON")
  message   String   @default("")
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

/// Append-only record of every admin mutation. Never edited or deleted by the app.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String?
  action     String
  targetType String
  targetId   String
  /// JSON blob of the change ({ before, after }); stored as text to stay
  /// portable across the raw-SQL paths this app uses.
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  bankName         String
  accountNumber    String
  accountHolder    String
  recipientAddress String   @default("")
  createdAt        DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model BankTransfer {
  id           String    @id @default(cuid())
  userId       String
  amountMYR    Float
  status       String    @default("PENDING")
  referenceNo  String    @unique
  bankName     String
  accountLast4 String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id])
}

model LoanTransaction {
  id          String   @id @default(cuid())
  wallet      String
  type        String
  amount      String
  txHash      String   @unique
  blockNumber Int
  createdAt   DateTime @default(now())

  @@index([wallet])
}

model KycSubmission {
  id          Int      @id @default(autoincrement())
  /// KYC belongs to the *account*: one submission per user, and it survives
  /// wallet unlinking. Keying by wallet was the old model, and it let the next
  /// account to claim a freed wallet inherit a stranger's verification.
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  /// The wallet this verification is anchored to on-chain (contract setKYC).
  /// Informational + admin lookup only — ownership is decided by userId.
  wallet      String
  fullName    String
  docType     String   @default("ic")
  icNumber    String
  dob         String
  gender      String
  nationality String
  phone       String
  email       String
  addr1       String
  addr2       String   @default("")
  postcode    String
  city        String
  state       String
  employment  String
  income      String
  purpose     String
  fundSource  String
  // Document images stored in-DB as data URIs (data:image/jpeg;base64,...), so
  // they are shared across all users via the same Supabase database. Served by
  // GET /api/kyc/documents.
  icFrontData String?
  icBackData  String?
  selfieData  String?
  status      String   @default("pending")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([wallet])
}
