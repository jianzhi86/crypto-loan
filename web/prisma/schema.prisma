generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Single direct connection. On Railway, set this to the Railway Postgres
  // service URL (reference ${{ Postgres.DATABASE_URL }}). No pooler/directUrl
  // needed since the DB is reachable directly within the Railway network.
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  password      String?
  walletAddress String?       @unique
  isAdmin       Boolean       @default(false)
  createdAt     DateTime      @default(now())
  bankAccount   BankAccount?
  transfers     BankTransfer[]
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  bankName         String
  accountNumber    String
  accountHolder    String
  recipientAddress String   @default("")
  createdAt        DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model BankTransfer {
  id           String    @id @default(cuid())
  userId       String
  amountMYR    Float
  status       String    @default("PENDING")
  referenceNo  String    @unique
  bankName     String
  accountLast4 String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id])
}

model LoanTransaction {
  id          String   @id @default(cuid())
  wallet      String
  type        String
  amount      String
  txHash      String   @unique
  blockNumber Int
  createdAt   DateTime @default(now())

  @@index([wallet])
}

model KycSubmission {
  id          Int      @id @default(autoincrement())
  wallet      String   @unique
  fullName    String
  docType     String   @default("ic")
  icNumber    String
  dob         String
  gender      String
  nationality String
  phone       String
  email       String
  addr1       String
  addr2       String   @default("")
  postcode    String
  city        String
  state       String
  employment  String
  income      String
  purpose     String
  fundSource  String
  // Document images stored in-DB as data URIs (data:image/jpeg;base64,...), so
  // they are shared across all users via the same Supabase database. Served by
  // GET /api/kyc/documents.
  icFrontData String?
  icBackData  String?
  selfieData  String?
  status      String   @default("pending")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
