# Copy this to .env and fill in the values

# PostgreSQL connection string.
# Railway: add a Postgres database to the project and set this to
#   ${{ Postgres.DATABASE_URL }} (Railway injects the real URL).
# Local dev: point at a local or hosted Postgres, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cryptoloan"

# Owner private key — used by the server to call setKYC() on behalf of users (no gas for users)
# On Hardhat local: account #0 key is 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# On production: use a dedicated wallet that owns the deployed contract
OWNER_PRIVATE_KEY=

# (Optional) Override the blockchain RPC URL — defaults to Hardhat localhost
# For Railway/production, point this to a public testnet RPC
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Etherscan API key — required for contract verification on public networks
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Alchemy API key — used for Sepolia / Mainnet RPC in hardhat.config.ts
# Get one at https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# Set to "true" to enable gas cost reporting after tests
REPORT_GAS=false
